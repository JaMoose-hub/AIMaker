# Allow only the published Pi 5, HC-SR04 and MRD-TF240 runtime exports.
# Pi includes the guided trial, its handheld baseline and reference recovery.
/models/*
!/models/README.md
!/models/manifest.json
!/models/board-pose-pi5-guided-20260922.onnx
