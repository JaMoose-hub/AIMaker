{
  "schema_version": "1.0",
  "id": "hw-123",
  "version": "1.0.0",
  "name": {"zh-TW": "HW-123 六軸陀螺儀／加速度計", "en": "HW-123 6-axis gyroscope/accelerometer"},
  "pins": [
