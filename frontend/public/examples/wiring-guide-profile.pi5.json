    "zh-TW": "自訂 Pi 5 與光敏模組接線。",
    "en": "Custom Pi 5 to photoresistor wiring."
  },
  "safety": {
    "zh-TW": "Pi 5 GPIO 僅支援 3.3V，不能輸入 5V。",
    "en": "Pi 5 GPIO is 3.3V only and must not receive 5V."
